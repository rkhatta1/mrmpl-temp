{
  "name": "non-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run next:dev convex:dev --ui=tui",
    "tui": "turbo run next:dev convex:dev --ui=tui",
    "dev:tui": "turbo run next:dev convex:dev --ui=tui",
    "next:dev": "bun run images:placeholders && next dev",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:seed": "bun scripts/seed-convex.ts",
    "products:merge-old": "bun scripts/merge-old-products.ts",
    "sync:priority-product-images": "bun scripts/sync-priority-product-images.ts",
    "upload:product-images": "bun scripts/upload-product-images.ts",
    "images:placeholders": "bun scripts/generate-image-placeholders.ts",
    "build": "bun run images:placeholders && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@phosphor-icons/react": "^2.1.10",
    "@types/bun": "^1.4.0",
    "@uploadthing/react": "^7.3.3",
    "axios": "^1.20.0",
    "better-auth": "1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-hot-toast": "^2.6.0",
    "read-excel-file": "^9.3.10",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "turbo": "2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "bun@1.3.14"
}
